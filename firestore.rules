rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection: Authenticated users can read profiles and manage their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Households collection: Access granted to the household owner (uid) or members
    match /households/{householdId} {
      allow read, write: if request.auth != null && (
        householdId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == householdId)
      );
    }
    
    // Home Assistant private tokens
    match /ha_tokens/{tokenId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null;
    }
  }
}
